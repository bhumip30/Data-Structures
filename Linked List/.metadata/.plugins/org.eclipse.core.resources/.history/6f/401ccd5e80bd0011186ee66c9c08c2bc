package doublyLinkedList;


public class DoublyLinkedListDemo {
	Node head;
	
	class Node{
		int data;
		Node previous;
		Node next;
		
		public Node(int data) {
			this.data = data;
			this.previous = null;
			this.next = null;
		}
	}
	
	
	public void insertAtEnd(int data) {
		Node newNode = new Node(data);
		if(head == null) {
			head = newNode;
			return;
		}
		
		Node temp = head;
		while(temp.next != null) {
			temp = temp.next;
		}
		temp.next = newNode;
		newNode.previous = temp;
	}
	
	public void insertAtBeginning(int data) {
		Node newNode = new Node(data);
		if(head == null) {
			head = newNode;
			return;
		}
		
		Node temp = head;
		newNode.next = temp;
		head.previous = newNode;
		head = newNode;
	}
	
	public void insertAtPosition(int position, int data) {
		Node newNode = new Node(data);
		Node temp = head;
		for(int i = 0; i < position - 1; i++) {
			temp = temp.next;
		}
		
		newNode.next = temp.next;
		newNode.previous = temp;
		temp.next.previous = newNode;
		temp.next = newNode;
		
	}
	
	public void displayForward() {
		Node temp = head;
		while(temp != null) {
			System.out.println("Data element" + " " + temp.data);
			temp = temp.next;
		}
	}
	
	public void displayBackward() {
		Node temp = head;
		while(temp.next != null) {
			temp = temp.next;
		}
		while(temp.previous != null) {
			System.out.println("Data by reverse: " + temp.data);
			temp = temp.previous;
		}
		System.out.println("null");
	}

	public static void main(String[] args) {
		DoublyLinkedListDemo doublyLinkedList = new DoublyLinkedListDemo();
		System.out.println("Insert at end......");
		doublyLinkedList.insertAtEnd(10);
		doublyLinkedList.insertAtEnd(20);
		doublyLinkedList.insertAtEnd(30);
		doublyLinkedList.insertAtEnd(40);
		doublyLinkedList.insertAtEnd(50);
		doublyLinkedList.displayForward();
		
		System.out.println("Insert at Beginning......");
		doublyLinkedList.insertAtBeginning(100);
		doublyLinkedList.insertAtBeginning(200);
		doublyLinkedList.displayForward();
		
		System.out.println("Insert at position 5 -> 300");
		doublyLinkedList.insertAtPosition(5, 300);
		doublyLinkedList.displayForward();
		doublyLinkedList.displayBackward();

	}

}
