package queue;

class Queue{
	private int queue[];
	private int maxSize;
	private int front;
	private int rare;
	
	
	public Queue(int maxSize) {
		this.queue = new int[maxSize];
		this.maxSize = maxSize;
		this.front = front;
		this.rare = rare;
	}
	
	public void enqueue(int data) {
		rare = rare + 1;
		queue[rare] = data;
	}
	
	public int dequeue() {
		int data = queue[front];
		front--;
		return data;
	}
	
}

public class QueueDemo {

	public static void main(String[] args) {
		Queue queue = new Queue(7);
		
		queue.enqueue(10);
		queue.enqueue(20);
		queue.enqueue(30);
		queue.enqueue(40);
		queue.enqueue(50);
		
		System.out.println("Element remove: "+ queue.dequeue());
		System.out.println("Element remove: "+ queue.dequeue());
		System.out.println("Element remove: "+ queue.dequeue());
		System.out.println("Element remove: "+ queue.dequeue());
		System.out.println("Element remove: "+ queue.dequeue());
	}

}
