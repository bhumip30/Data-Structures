package sum;

public class ArraySum {
	
	public static int SumofRow(int[] [] arr) {
		int max = 0;
		int index = 0;
		for (int i = 0; i < arr.length; i++) {
			int sum = 0;
			for(int j = 0; j < arr[i].length; j++) {
				sum = sum + arr[i][j];
			}
			
			if(sum > max) {
				max = sum;
				index = i;
			}
		}
		for (int j = 0; j < arr[index].length; j++) {
			System.out.println(arr[index][j] + " ");
		}
	}
	
