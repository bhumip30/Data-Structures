package transpose;

public class ArrayTranspose {
	
	public static void Transpose(int[] [] arr) {
		int row = arr.length;
		int column = arr[0].length;
		
		for(int i = 0; i < row; i ++) {
			for(int j = 0; j < column ; j++) {
				System.out.println(arr[j][i] + " ");
			}
			System.out.println();
		}
	}

	public static void main(String[] args) {
		int[] [] arr = new int [] [] {
			{5,3,7},
			{8,9,4},
			{3,5,7}
		};
		
		Transpose(arr);
	}

}
