package rotate;

public class Rotate90Anti {
	
	public static void Rotae90ticlockwise(int[] [] arr) {
		//Transpose of array
		for(int i = 0; i < arr.length; i++) {
			for(int j = i + 1; j < arr.length; j++) {
				int temp = arr[i][j];
				arr[i][j] = arr[j][i];
				arr[j][i] = temp;
			}
		}
		
		//Reverse ecach element
		for (int i = 0; i < arr.length; i++) {
			int start = 0;
			int end = arr.length - 1;
			
			while (start < end) {
				int temp1 = arr[start][i];
				arr[start][i] = arr[end][i];
				arr[end][i] = temp1; 
			}
		}
	}

	public static void main(String[] args) {
		int [] [] arr = {
				{4,2,5},
				{7,5,9},
				{5,7,2}
		};
		

	}

}
