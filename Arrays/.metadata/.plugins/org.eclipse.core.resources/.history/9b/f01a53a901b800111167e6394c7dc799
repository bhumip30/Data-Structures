package sum;

public class ArraySum {
	
	public static int SumofRow(int[] [] arr) {
		int max = 0;
		for (int i = 0; i < arr.length; i++) {
			int sum = 0;
			for(int j = 0; j < arr[i].length; j++) {
				sum = sum + arr[i][j];
			}
			
			if(sum > max) {
				max = sum;
			}
		}
		return max;
	}

	public static void main(String[] args) {
		int [] [] arr = new int [] [] {
			{1,2,3},
			{7,5,3},
			{9,5,2}
		};
		
		System.out.println("Sun of row:" + SumofRow(arr));
		

	}

}
