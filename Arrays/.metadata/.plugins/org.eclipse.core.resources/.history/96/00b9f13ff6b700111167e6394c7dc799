package reverse;

public class ArrayReverse {
	
	public static void ArrayReverse(int arr[]) {
		int start = 0;
		int end = arr.length - 1;
		
		while(start < end) {
			int temp = arr[start];
			arr[start] = arr[end];
			arr[end] = temp;
			
			start++;
			end--;
		}
	}

	public static void main(String[] args) {
		int [] arr = {1,2,3,4,5};
		
		ArrayReverse(arr);
		
		System.out.println("Reveresd Array: ");
		for(int i = 0; i < arr.length; i++) {
			System.out.println(i);
		}
	}

}
