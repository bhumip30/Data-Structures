package selectionSort;

import java.util.Arrays;

public class SelectionSort {

	public static void main(String[] args) {
		int [] arr = {5,2,6,76,86,4};
		int n = arr.length - 1;
		
		for(int i = 0; i < n - 1; i++) {
			int minIndex = i;
			for(int j = i + 1; j < n; j++) {
				if(arr[j] < arr[minIndex]) {
					minIndex = j;
				}
				
			}
		if(i != minIndex) {
			int temp = arr[i];
			arr[i] = arr[minIndex];
			arr[minIndex] = temp;
		}
			
	}
		
		
	System.out.println(Arrays.toString(arr));

	}

}
