package selectionSort;

import java.util.Arrays;

public class SelectionSort {

	public static void main(String[] args) {
		int [] arr = {5,2,6,76,86,4};
		int n = arr.length - 1;
		
		for(int i = 0; i < n - 1; i++) {
			int maxIndex = 0;
			for(int j = i + 1; j < n; j++) {
				if(arr[j] < arr[maxIndex]) {
					maxIndex = j;
				}
				if(i != maxIndex) {
					int temp = arr[i];
					arr[i] = arr[maxIndex];
					arr[maxIndex] = temp;
				}
			}
			
		}
		
		
		System.out.println(Arrays.toString(arr));

	}

}
