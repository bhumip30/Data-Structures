package customs;

public class Fibonacci {

	public static void main(String[] args) {
		int n = 7;
		System.out.println("Fibonacci: " + findFibonacci(n));


	}
	
	public static int findFibonacci(int n) {
		if(n == 0 || n == 1) {
			return 1;
		}
		return findFibonacci(n - 1) + findFibonacci(n - 2);
	}

}
